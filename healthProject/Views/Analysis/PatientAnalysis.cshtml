                    const d = document.getElementById('dailyDate').value;
                    if (!d) { alert('請先選擇日期'); return; }
                    startDate = endDate = d;
                    break;
                }
                case 1: {
                    const ws = document.getElementById('weeklyStartDate').value;
                    if (!ws) { alert('請先選擇週開始日期'); return; }
                    startDate = ws;
                    const we = new Date(ws);
                    we.setDate(we.getDate() + 6);
                    endDate = we.toISOString().substr(0, 10);
                    break;
                }
                case 2: {
                    const m = document.getElementById('monthlyDate').value;
                    if (!m) { alert('請先選擇年月'); return; }
                    const [yr, mo] = m.split('-');
                    startDate = `${yr}-${mo}-01`;
                    endDate = `${yr}-${mo}-${new Date(yr, mo, 0).getDate().toString().padStart(2, '0')}`;
                    break;
                }
                case 3: {
                    const y = document.getElementById('yearlyDate').value;
                    if (!y) { alert('請先選擇年份'); return; }
                    startDate = `${y}-01-01`;
                    endDate = `${y}-12-31`;
                    break;
                }
            }

            const originalHtml = btn.innerHTML;

            btn.disabled = true;
            btn.innerHTML = '📤 傳送中...';

            try {
                const apiUrl = window.location.origin + '/Analysis/SendAnalysisPdfToLine';

                const res = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        reportType: currentReportType,
                        startDate,
                        endDate
                    })
                });

                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                const result = await res.json();

                alert(result.success
                    ? '✅ 已收到您的申請，PDF 報表完成後會傳送到 LINE，請稍候查看。'
                    : '❌ ' + (result.message || '傳送失敗，請稍後再試'));

                } catch (e) {
                    console.error(e);
                    alert('❌ 系統暫時無法傳送 PDF 報表，請稍後再試。');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
        }
    </script>
</body>
</html>
