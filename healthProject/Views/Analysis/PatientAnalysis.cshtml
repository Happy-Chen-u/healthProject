        function buildPeriodLabels(startDate, endDate) {
            const labels = [];
            const start = new Date(startDate);
            const end = new Date(endDate);

            // 年報用月份，週/月報用日期
            if (currentReportType === 3) {
                for (let m = 0; m < 12; m++) {
                    labels.push(`${start.getFullYear()}-${String(m + 1).padStart(2, '0')}`);
                }
                return labels;
            }

            const d = new Date(start);
            while (d <= end) {
                labels.push(
                    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`
                );
                d.setDate(d.getDate() + 1);
            }

            return labels;
        }

        function drawCharts(cd) {
                if (!cd) return;

                Object.values(charts).forEach(c => c && c.destroy());
                charts = {};
                chartRanges = {};

            const makeChart = (id, cfg, name) => {
                const el = document.getElementById(id);
                if (!el) return;

                const wrapper = el.closest('.chart-inner');
                if (wrapper) {
                    const old = wrapper.querySelector('.no-data-overlay');
                    if (old) old.remove();
                    wrapper.style.position = '';
                }

                const labels = cfg.data.labels || [];
                const total = labels.length;
                let startIdx = 0;
                let endIdx = Math.min(CHART_VISIBLE - 1, total - 1);
                let hasDataInRange = false;

                const originalData = {
                    labels: [...labels],
                    datasets: cfg.data.datasets.map(ds => ({
                        ...ds,
                        data: [...ds.data]
                    }))
                };

                if (currentReport?.startDate && currentReport?.endDate && total > 0) {
                    const start = currentReport.startDate.substring(0, 10);
                    const end = currentReport.endDate.substring(0, 10);

                    let queryStartIdx = -1;
                    for (let i = 0; i < labels.length; i++) {
                        if (labels[i] >= start) {
                            queryStartIdx = i;
                            break;
                        }
                    }

                    let queryEndIdx = -1;
                    for (let i = labels.length - 1; i >= 0; i--) {
                        if (labels[i] <= end) {
                            queryEndIdx = i;
                            break;
                        }
                    }

                    if (queryStartIdx >= 0 && queryEndIdx >= 0 && queryStartIdx <= queryEndIdx) {
                        hasDataInRange = true;
                        const rangeCount = queryEndIdx - queryStartIdx + 1;
                        startIdx = queryStartIdx;
                        endIdx = rangeCount >= CHART_VISIBLE
                            ? startIdx + CHART_VISIBLE - 1
                            : queryEndIdx;
                    }
                }

                if (!hasDataInRange && currentReport?.startDate && currentReport?.endDate) {
                    const start = currentReport.startDate.substring(0, 10);
                    const end = currentReport.endDate.substring(0, 10);
                    const emptyLabels = buildPeriodLabels(start, end);

                    let targetMin = 0;
                    let targetMax = Math.min(CHART_VISIBLE - 1, total - 1);
                    let emptySide = 'gap';

                    if (total > 0) {
                        if (start > labels[total - 1]) {
                            emptySide = 'after';
                            targetMax = total - 1;
                            targetMin = Math.max(0, targetMax - CHART_VISIBLE + 1);
                        } else if (end < labels[0]) {
                            emptySide = 'before';
                            targetMin = 0;
                            targetMax = Math.min(CHART_VISIBLE - 1, total - 1);
                        }
                    }

                    cfg.data = {
                        labels: emptyLabels,
                        datasets: cfg.data.datasets.map(ds => ({
                            ...ds,
                            data: emptyLabels.map(() => null),
                            pointRadius: 0
                        }))
                    };

                    chartRanges[name] = {
                        min: 0,
                        max: Math.min(CHART_VISIBLE - 1, emptyLabels.length - 1),
                        total: emptyLabels.length,
                        isEmptyPeriod: true,
                        emptySide,
                        targetMin,
                        targetMax,
                        originalData
                    };
                } else {
                    chartRanges[name] = {
                        min: startIdx,
                        max: endIdx,
                        total,
                        isEmptyPeriod: false,
                        originalData
                    };

                    cfg.options.scales.x.min = labels[startIdx];
                    cfg.options.scales.x.max = labels[endIdx];
                }

                charts[name] = new Chart(el.getContext('2d'), cfg);
                charts[name].update('none');

                if (!hasDataInRange && wrapper) {
                    wrapper.style.position = 'relative';

                    const overlay = document.createElement('div');
