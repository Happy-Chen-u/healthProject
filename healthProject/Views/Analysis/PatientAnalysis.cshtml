        // ── 圖表箭頭導航 ─────────────────────────────────
        function navigateChart(name, dir) {
            const chart = charts[name];
            if (!chart) return;

            const r = chartRanges[name];
            if (!r) return;

            if (r.isEmptyPeriod) {
                if (r.emptySide === 'after' && dir > 0) {
                    showChartEdgeNotice(name, '已無更新的資料');
                    return;
                }

                if (r.emptySide === 'before' && dir < 0) {
                    showChartEdgeNotice(name, '已無更早的資料');
                    return;
                }

                chart.data.labels = r.originalData.labels;
                chart.data.datasets = r.originalData.datasets;

                chart.options.scales.x.min = r.originalData.labels[r.targetMin];
                chart.options.scales.x.max = r.originalData.labels[r.targetMax];

                chartRanges[name] = {
                    ...r,
                    min: r.targetMin,
                    max: r.targetMax,
                    total: r.originalData.labels.length,
                    isEmptyPeriod: false
                };

                removeNoDataOverlay(name);
                chart.update('none');
                return;
            }

            const labels = chart.data.labels;

            if (dir < 0 && r.min === 0) {
                showChartEdgeNotice(name, '已無更早的資料');
                return;
            }

            if (dir > 0 && r.max >= r.total - 1) {
                showChartEdgeNotice(name, '已無更新的資料');
                return;
            }

            let newMin = r.min + dir * CHART_STEP;
            let newMax = newMin + CHART_VISIBLE - 1;

            if (newMin < 0) {
                newMin = 0;
                newMax = Math.min(CHART_VISIBLE - 1, r.total - 1);
            }

            if (newMax >= r.total) {
                newMax = r.total - 1;
                newMin = Math.max(0, newMax - CHART_VISIBLE + 1);
            }

            chartRanges[name] = {
                ...r,
                min: newMin,
                max: newMax
            };

            chart.options.scales.x.min = labels[newMin];
            chart.options.scales.x.max = labels[newMax];

            removeNoDataOverlay(name);
            chart.update('none');
        }

