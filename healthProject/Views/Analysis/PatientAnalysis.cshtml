        async function testWeeklyReport() {
            if (!confirm('確定要傳送上週健康週報到您的 LINE 嗎？\n\n注意：需要先綁定 LINE 帳號才能接收週報。')) return;
            const btn = event.target.closest('button'),
            originalHtml = btn.innerHTML;
            btn.disabled = true; btn.innerHTML = '📤 傳送中...';
            try {
                const res = await fetch('/Analysis/TestWeeklyReport', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const result = await res.json();
                alert(result.success ? '✅ ' + result.message : '❌ ' + result.message);
            } catch (e) { alert('❌ 系統錯誤: ' + e.message); }
            finally { btn.disabled = false; btn.innerHTML = originalHtml; }
        }
        let chartsLoaded = false;

        function buildPatientReportPayload() {
            let startDate, endDate;

            switch (currentReportType) {
                case 0: {
                    const d = document.getElementById('dailyDate').value;
                    if (!d) { alert('請先選擇日期'); return null; }
                    startDate = endDate = d;
                    break;
                }
                case 1: {
                    const ws = document.getElementById('weeklyStartDate').value;
                    if (!ws) { alert('請先選擇週開始日期'); return null; }
                    startDate = ws;
                    const we = new Date(ws);
                    we.setDate(we.getDate() + 6);
                    endDate = we.toISOString().substr(0, 10);
                    break;
                }
                case 2: {
                    const m = document.getElementById('monthlyDate').value;
                    if (!m) { alert('請先選擇年月'); return null; }
                    const [yr, mo] = m.split('-');
                    startDate = `${yr}-${mo}-01`;
                    endDate = `${yr}-${mo}-${new Date(yr, mo, 0).getDate().toString().padStart(2, '0')}`;
                    break;
                }
                case 3: {
                    const y = document.getElementById('yearlyDate').value;
                    if (!y) { alert('請先選擇年份'); return null; }
                    startDate = `${y}-01-01`;
                    endDate = `${y}-12-31`;
                    break;
                }
            }

            return {
                reportType: currentReportType,
                startDate,
                endDate
            };
        }

        //下載pdf
        async function downloadPatientPdf(btn) {
            const payload = buildPatientReportPayload();
            if (!payload) return;

            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i><span> 下載中...</span>';

            try {
                const res = await fetch('/Analysis/DownloadAnalysisPdf', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(payload)
                });

                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                const blob = await res.blob();
                const url = window.URL.createObjectURL(blob);

                const a = document.createElement('a');
                a.href = url;
                a.download = `健康報表_${payload.startDate}_${payload.endDate}.pdf`;
                document.body.appendChild(a);
                a.click();

                a.remove();
                window.URL.revokeObjectURL(url);
            } catch (e) {
                console.error(e);
                alert('❌ PDF 下載失敗，請稍後再試。');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }

