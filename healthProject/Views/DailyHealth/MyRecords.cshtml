@model List<DailyRecordGroup>
@{
    ViewData["Title"] = "我的健康紀錄";
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        :root {
            --navy: #0a2540;
            --navy-mid: #103a5e;
            --blue: #1a6fb5;
            --blue-lt: #2589d8;
            --bg: #f4f6f9;
            --surface: #ffffff;
            --border: #dde3ea;
            --text: #1a2635;
            --text-sub: #5a6a7e;
            --text-pale: #8fa0b4;
            --danger: #c0392b;
            --success: #2e7d32;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            min-height: 100%;
            font-family: 'Noto Sans TC', 'Microsoft JhengHei', sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        /* ── TOP BAR ── */
        .topbar {
            background: var(--navy);
            height: 56px;
            display: flex;
            align-items: center;
            padding: 0 2rem;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 12px rgba(0,0,0,0.25);
        }

        .topbar-logo {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: white;
            font-weight: 700;
            font-size: 1rem;
        }

        .cross {
            width: 28px;
            height: 28px;
            background: var(--blue-lt);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            font-weight: 900;
            color: white;
        }

        .topbar-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .topbar-back {
            color: rgba(255,255,255,0.65);
            background: none;
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 6px;
            padding: 0.3rem 0.85rem;
            font-size: 0.8rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.35rem;
            transition: all 0.2s;
        }

            .topbar-back:hover {
                background: rgba(255,255,255,0.1);
                color: white;
                text-decoration: none;
            }

        /* ── HERO ── */
        .hero {
            background: linear-gradient(100deg, var(--navy-mid) 0%, var(--blue) 100%);
            padding: 2rem 2.5rem 1.75rem;
            position: relative;
            overflow: hidden;
        }

            .hero::after {
                content: '';
                position: absolute;
                right: -60px;
                top: -60px;
                width: 240px;
                height: 240px;
                border-radius: 50%;
                background: rgba(255,255,255,0.04);
                pointer-events: none;
            }

        .hero-eyebrow {
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.5);
            margin-bottom: 0.4rem;
        }

        .hero-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: white;
            margin-bottom: 0.4rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .hero-sub {
            font-size: 0.82rem;
            color: rgba(255,255,255,0.55);
        }

        /* ── CONTENT ── */
        .content {
            max-width: 1100px;
            margin: 0 auto;
            padding: 1.5rem 2.5rem;
        }

        /* ── SEARCH BAR ── */
        .search-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1rem 1.25rem;
            margin-bottom: 1.25rem;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            display: flex;
            align-items: flex-end;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .search-label {
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--text-sub);
            margin-bottom: 0.35rem;
            display: block;
        }

        .date-input {
            padding: 0.55rem 0.85rem;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-size: 0.88rem;
            font-family: inherit;
            outline: none;
            transition: border-color 0.2s;
            width: 200px;
        }

            .date-input:focus {
                border-color: var(--blue-lt);
            }

        .search-result {
            font-size: 0.8rem;
            color: var(--text-sub);
            margin-left: 0.25rem;
        }

        /* ── BUTTONS ── */
        .btn {
            padding: 0.55rem 1.1rem;
            border: none;
            border-radius: 7px;
            font-size: 0.83rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            transition: all 0.15s;
            font-family: inherit;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--navy);
            color: white;
        }

            .btn-primary:hover {
                background: var(--navy-mid);
                color: white;
                text-decoration: none;
            }

        .btn-secondary {
            background: var(--surface);
            border: 1.5px solid var(--border);
            color: var(--text-sub);
        }

            .btn-secondary:hover {
                background: var(--bg);
                color: var(--text-sub);
                text-decoration: none;
            }

        .btn-add {
            background: #e8f5e9;
            color: var(--success);
            border: 1px solid #c8e6c9;
        }

            .btn-add:hover {
                background: #c8e6c9;
                text-decoration: none;
                color: var(--success);
            }

        /* ── DATE GROUP CARD ── */
        .date-group {
            background: var(--surface);
            border-radius: 12px;
            border: 1px solid var(--border);
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            margin-bottom: 1.25rem;
            overflow: hidden;
        }

        .date-header {
            background: linear-gradient(100deg, var(--navy-mid) 0%, var(--blue) 100%);
            padding: 1rem 1.5rem;
        }

        .date-title {
            font-size: 1rem;
            font-weight: 700;
            color: white;
            margin-bottom: 0.4rem;
        }

        .date-summary {
            display: flex;
            gap: 1.25rem;
            flex-wrap: wrap;
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
        }

        .summary-item {
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        /* ── TOGGLE BUTTON ── */
        .toggle-bar {
            padding: 0.75rem 1.5rem;
            background: var(--bg);
            border-bottom: 1px solid var(--border);
        }

        .btn-toggle {
            width: 100%;
            padding: 0.6rem;
            border-radius: 7px;
            border: 1.5px solid var(--border);
            background: var(--surface);
            color: var(--text-sub);
            font-size: 0.83rem;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
        }

            .btn-toggle:hover {
                background: var(--bg);
                border-color: var(--blue-lt);
                color: var(--blue);
            }

            .btn-toggle.active {
                background: #e8f0fb;
                border-color: var(--blue);
                color: var(--blue);
            }

        /* ── RECORD ITEMS ── */
        .record-items {
            padding: 1rem 1.5rem;
        }

        .record-item {
            background: var(--bg);
            border-left: 3px solid var(--blue);
            border-radius: 8px;
            padding: 1rem 1.25rem;
            margin-bottom: 0.75rem;
        }

            .record-item:last-child {
                margin-bottom: 0;
            }

        .record-time {
            font-size: 0.82rem;
            color: var(--text-sub);
            font-weight: 600;
            margin-bottom: 0.85rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .data-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 0.75rem;
        }

        .data-item {
            padding: 0.65rem 0.85rem;
            background: var(--surface);
            border-radius: 6px;
            border-left: 3px solid var(--blue-lt);
        }

        .data-label {
            font-size: 0.75rem;
            color: var(--text-sub);
            margin-bottom: 0.3rem;
        }

        .data-value {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text);
        }

        /* ── DAILY SUMMARY ── */
        .daily-summary {
            margin: 0 1.5rem 1.25rem;
            background: linear-gradient(100deg, #e8f0fb 0%, #d6e4f7 100%);
            border-radius: 10px;
            padding: 1rem 1.25rem;
            border: 1px solid #b8d0f5;
        }

        .daily-summary-title {
            font-size: 0.83rem;
            font-weight: 700;
            color: var(--navy-mid);
            margin-bottom: 0.75rem;
        }

        /* ── EDIT/LOCK BUTTON ── */
        .btn-edit {
            padding: 0.25rem 0.7rem;
            border-radius: 5px;
            font-size: 0.75rem;
            font-weight: 600;
            background: #e8f0fb;
            color: var(--blue);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            transition: background 0.15s;
        }

            .btn-edit:hover {
                background: #d6e4f7;
                color: var(--blue);
                text-decoration: none;
            }

        .btn-locked {
            padding: 0.25rem 0.7rem;
            border-radius: 5px;
            font-size: 0.75rem;
            font-weight: 600;
            background: var(--bg);
            color: var(--text-pale);
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
        }

        /* ── EMPTY STATE ── */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            background: var(--surface);
            border-radius: 12px;
            border: 1px solid var(--border);
        }

        .empty-icon {
            font-size: 3rem;
            margin-bottom: 0.75rem;
            opacity: 0.4;
        }

        .empty-text {
            color: var(--text-sub);
            font-size: 0.95rem;
            margin-bottom: 1.25rem;
        }

        @@media (max-width: 768px) {
            .topbar {
                padding: 0 1rem;
            }

            .hero {
                padding: 1.5rem 1.25rem;
            }

            .content {
                padding: 1rem;
            }

            .date-input {
                width: 100%;
            }

            .search-card {
                flex-direction: column;
                align-items: stretch;
            }

            .data-grid {
                grid-template-columns: 1fr;
            }

            .date-summary {
                gap: 0.75rem;
            }
        }
    </style>
</head>
<body>

    <!-- TOP BAR -->
    <header class="topbar">
        <div class="topbar-logo">
            <div class="cross">✚</div>
            代謝症候群疾病管理與追蹤系統
        </div>
        <div class="topbar-right">
            <a href="@Url.Action("Index", "DailyHealth")" class="topbar-back">
                <i class="bi bi-arrow-left"></i> 返回選單
            </a>
        </div>
    </header>

    <!-- HERO -->
    <div class="hero">
        <div class="hero-eyebrow">Health Records</div>
        <div class="hero-title">
            <i class="bi bi-journal-medical"></i>
            我的健康紀錄
        </div>
        <div class="hero-sub">查看與管理您的歷史健康資訊</div>
    </div>

    <!-- CONTENT -->
    <div class="content">

        <!-- 搜尋 -->
        <div class="search-card">
            <div style="flex:1; min-width:180px;">
                <label class="search-label"><i class="bi bi-calendar3"></i> 搜尋日期</label>
                <input type="date" id="searchDate" class="date-input" onchange="filterByDate()" />
            </div>
            <div style="display:flex; gap:0.5rem; align-items:flex-end;">
                <button onclick="filterByDate()" class="btn btn-primary">
                    <i class="bi bi-search"></i> 搜尋
                </button>
                <button onclick="clearSearch()" class="btn btn-secondary">
                    <i class="bi bi-arrow-clockwise"></i> 顯示全部
                </button>
                <a href="@Url.Action("Create", "DailyHealth")" class="btn btn-add">
                    <i class="bi bi-plus-lg"></i> 新增記錄
                </a>
            </div>
            <div id="searchResult" class="search-result"></div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div id="recordsContainer">
                @foreach (var group in Model)
                {
                    <div class="date-group" data-date="@group.Date.ToString("yyyy-MM-dd")">

                        <div class="date-header">
                            <div class="date-title">
                                <i class="bi bi-calendar-check-fill"></i>
                                @group.Date.ToString("yyyy年MM月dd日 (dddd)")
                            </div>
                            <div class="date-summary">
                                <span class="summary-item"><i class="bi bi-files"></i> @group.Records.Count 筆記錄</span>
                                @if (group.TotalWater > 0)
                                {
                                    <span class="summary-item"><i class="bi bi-droplet-fill"></i> @group.TotalWater.Value.ToString("0") ml</span>
                                }
                                @if (group.TotalExercise > 0)
                                {
                                    <span class="summary-item"><i class="bi bi-bicycle"></i> @group.TotalExercise.Value.ToString("0") 分鐘</span>
                                }
                                @if (group.AvgSystolicBP.HasValue && group.AvgDiastolicBP.HasValue)
                                {
                                    <span class="summary-item"><i class="bi bi-heart-pulse-fill"></i> @group.AvgSystolicBP.Value.ToString("0")/@group.AvgDiastolicBP.Value.ToString("0") mmHg</span>
                                }
                            </div>
                        </div>

                        @if (group.Records.Count > 1)
                        {
                            <div class="toggle-bar">
                                <button onclick="toggleDetails(this)" class="btn-toggle">
                                    <i class="bi bi-list-ul"></i>
                                    顯示全部 @group.Records.Count 筆紀錄
                                </button>
                            </div>
                        }

                        <div class="record-items" style="@(group.Records.Count > 1 ? "display:none;" : "")">
                            @foreach (var record in group.Records)
                            {
                                <div class="record-item">
                                    <div class="record-time">
                                        <i class="bi bi-clock"></i>
                                        @(record.RecordTime?.ToString(@"hh\:mm") ?? "未記錄時間")
                                        @{
                                            var editDeadline = DateTime.Today.AddDays(-6);
                                            var canEdit = group.Date >= editDeadline;
                                        }
                                        @if (canEdit)
                                        {
                                            <a href="@Url.Action("Edit", "DailyHealth", new { id = record.Id })" class="btn-edit">
                                                <i class="bi bi-pencil"></i> 編輯
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="btn-locked" title="僅可編輯近 7 天內的紀錄">
                                                <i class="bi bi-lock-fill"></i> 已鎖定
                                            </span>
                                        }
                                    </div>

                                    <div class="data-grid">
                                        @if (record.BP_First_1_Systolic.HasValue || record.BP_First_1_Diastolic.HasValue ||
                                       record.BP_First_2_Systolic.HasValue || record.BP_First_2_Diastolic.HasValue ||
                                       record.BP_Second_1_Systolic.HasValue || record.BP_Second_1_Diastolic.HasValue ||
                                       record.BP_Second_2_Systolic.HasValue || record.BP_Second_2_Diastolic.HasValue)
                                        {
                                            <div class="data-item" style="grid-column: 1 / -1;">
                                                <div class="data-label">❤️ 血壓測量</div>
                                                <div class="data-value" style="line-height:1.9; font-size:0.85rem;">
                                                    @if (record.BP_First_1_Systolic.HasValue && record.BP_First_1_Diastolic.HasValue)
                                                    {
                                                        <div>上午第一遍：@record.BP_First_1_Systolic.Value.ToString("0")/@record.BP_First_1_Diastolic.Value.ToString("0") mmHg</div>
                                                    }
                                                    @if (record.BP_First_2_Systolic.HasValue && record.BP_First_2_Diastolic.HasValue)
                                                    {
                                                        <div>上午第二遍：@record.BP_First_2_Systolic.Value.ToString("0")/@record.BP_First_2_Diastolic.Value.ToString("0") mmHg</div>
                                                    }
                                                    @if (record.BP_Second_1_Systolic.HasValue && record.BP_Second_1_Diastolic.HasValue)
                                                    {
                                                        <div>睡前第一遍：@record.BP_Second_1_Systolic.Value.ToString("0")/@record.BP_Second_1_Diastolic.Value.ToString("0") mmHg</div>
                                                    }
                                                    @if (record.BP_Second_2_Systolic.HasValue && record.BP_Second_2_Diastolic.HasValue)
                                                    {
                                                        <div>睡前第二遍：@record.BP_Second_2_Systolic.Value.ToString("0")/@record.BP_Second_2_Diastolic.Value.ToString("0") mmHg</div>
                                                    }
                                                    @if (record.AvgSystolicBP.HasValue && record.AvgDiastolicBP.HasValue)
                                                    {
                                                        <div style="color:var(--blue); font-weight:700; margin-top:0.2rem;">
                                                            平均：@record.AvgSystolicBP.Value.ToString("0")/@record.AvgDiastolicBP.Value.ToString("0") mmHg
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (record.Meals_Breakfast != null)
                                        {
                                            <div class="data-item">
                                                <div class="data-label">🌅 早餐</div>
                                                <div class="data-value" style="font-size:0.85rem; line-height:1.7;">
                                                    @Html.Raw(record.Meals_Breakfast.ToString().Replace(", ", "<br />"))
                                                </div>
                                            </div>
                                        }
                                        @if (record.Meals_Lunch != null)
                                        {
                                            <div class="data-item">
                                                <div class="data-label">☀️ 午餐</div>
                                                <div class="data-value" style="font-size:0.85rem; line-height:1.7;">
                                                    @Html.Raw(record.Meals_Lunch.ToString().Replace(", ", "<br />"))
                                                </div>
                                            </div>
                                        }
                                        @if (record.Meals_Dinner != null)
                                        {
                                            <div class="data-item">
                                                <div class="data-label">🌙 晚餐</div>
                                                <div class="data-value" style="font-size:0.85rem; line-height:1.7;">
                                                    @Html.Raw(record.Meals_Dinner.ToString().Replace(", ", "<br />"))
                                                </div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(record.ExerciseType) || record.ExerciseDuration.HasValue)
                                        {
                                            <div class="data-item">
                                                <div class="data-label">🏃 運動</div>
                                                <div class="data-value">
                                                    @(record.ExerciseType ?? "運動")
                                                    @(record.ExerciseDuration.HasValue ? $" {record.ExerciseDuration:0.0} 分鐘" : "")
                                                </div>
                                            </div>
                                        }
                                        @if (record.WaterIntake.HasValue)
                                        {
                                            <div class="data-item">
                                                <div class="data-label">💧 水分攝取</div>
                                                <div class="data-value">@record.WaterIntake.Value.ToString("0") ml</div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(record.Beverage))
                                        {
                                            <div class="data-item">
                                                <div class="data-label">🥤 飲料</div>
                                                <div class="data-value">@record.Beverage</div>
                                            </div>
                                        }
                                        @if (record.Cigarettes.HasValue && record.Cigarettes > 0)
                                        {
                                            <div class="data-item">
                                                <div class="data-label">🚬 抽菸</div>
                                                <div class="data-value">@record.Cigarettes.Value.ToString("0") 支</div>
                                            </div>
                                        }
                                        @if (record.BetelNut.HasValue && record.BetelNut > 0)
                                        {
                                            <div class="data-item">
                                                <div class="data-label">🌿 檳榔</div>
                                                <div class="data-value">@record.BetelNut.Value.ToString("0") 次</div>
                                            </div>
                                        }
                                        @if (record.BloodSugar.HasValue)
                                        {
                                            <div class="data-item">
                                                <div class="data-label">🩸 血糖</div>
                                                <div class="data-value">@record.BloodSugar.Value.ToString("0.0") mg/dL</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        @if (group.Records.Count > 1)
                        {
                            <div class="daily-summary">
                                <div class="daily-summary-title"><i class="bi bi-bar-chart-fill"></i> 今日統計</div>
                                <div class="data-grid">
                                    @if (group.TotalWater > 0)
                                    {
                                        <div class="data-item">
                                            <div class="data-label">💧 總水分攝取</div>
                                            <div class="data-value">@group.TotalWater.Value.ToString("0") ml</div>
                                        </div>
                                    }
                                    @if (group.TotalExercise > 0)
                                    {
                                        <div class="data-item">
                                            <div class="data-label">🏃 總運動時間</div>
                                            <div class="data-value">@group.TotalExercise.Value.ToString("0") 分鐘</div>
                                        </div>
                                    }
                                    @if (group.AvgSystolicBP.HasValue && group.AvgDiastolicBP.HasValue)
                                    {
                                        <div class="data-item">
                                            <div class="data-label">❤️ 平均血壓</div>
                                            <div class="data-value">@group.AvgSystolicBP.Value.ToString("0")/@group.AvgDiastolicBP.Value.ToString("0") mmHg</div>
                                        </div>
                                    }
                                    @if (group.AvgBloodSugar.HasValue)
                                    {
                                        <div class="data-item">
                                            <div class="data-label">🩸 平均血糖</div>
                                            <div class="data-value">@group.AvgBloodSugar.Value.ToString("0.0") mg/dL</div>
                                        </div>
                                    }
                                    @if (group.TotalCigarettes > 0)
                                    {
                                        <div class="data-item">
                                            <div class="data-label">🚬 總抽菸量</div>
                                            <div class="data-value">@group.TotalCigarettes.Value.ToString("0") 支</div>
                                        </div>
                                    }
                                    @if (group.TotalBetelNut > 0)
                                    {
                                        <div class="data-item">
                                            <div class="data-label">🌿 總檳榔量</div>
                                            <div class="data-value">@group.TotalBetelNut.Value.ToString("0") 次</div>
                                        </div>
                                    }
                                    @if (group.HasAnyMeals)
                                    {
                                        <div class="data-item" style="grid-column: 1 / -1;">
                                            <div class="data-label">🍽️ 今日三餐總計</div>
                                            <div class="data-value" style="font-size:0.85rem; line-height:1.8;">
                                                @if (!string.IsNullOrEmpty(group.TotalVegetables.Display) && group.TotalVegetables.Display != "0")
                                                {
                                                    <div>🥬 蔬菜：@group.TotalVegetables.Display</div>
                                                }
                                                @if (!string.IsNullOrEmpty(group.TotalProtein.Display) && group.TotalProtein.Display != "0")
                                                {
                                                    <div>🥩 蛋白質：@group.TotalProtein.Display</div>
                                                }
                                                @if (!string.IsNullOrEmpty(group.TotalCarbs.Display) && group.TotalCarbs.Display != "0")
                                                {
                                                    <div>🍚 澱粉：@group.TotalCarbs.Display</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="bi bi-journal-x"></i></div>
                <div class="empty-text">目前還沒有任何健康紀錄</div>
                <a href="@Url.Action("Create", "DailyHealth")" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> 新增第一筆紀錄
                </a>
            </div>
        }
    </div>

    <script>
        function toggleDetails(button) {
            const dateGroup = button.closest('.date-group');
            const recordItems = dateGroup.querySelector('.record-items');
            const isHidden = recordItems.style.display === 'none';
            if (isHidden) {
                recordItems.style.display = 'block';
                button.innerHTML = '<i class="bi bi-chevron-up"></i> 隱藏詳細記錄';
                button.classList.add('active');
            } else {
                recordItems.style.display = 'none';
                const count = recordItems.querySelectorAll('.record-item').length;
                button.innerHTML = `<i class="bi bi-list-ul"></i> 顯示全部 ${count} 筆紀錄`;
                button.classList.remove('active');
            }
        }

        function filterByDate() {
            const searchDate = document.getElementById('searchDate').value;
            const resultDiv = document.getElementById('searchResult');
            if (!searchDate) { resultDiv.innerHTML = '<span style="color:#f59e0b;">⚠️ 請選擇日期</span>'; return; }
            let found = 0;
            document.querySelectorAll('.date-group').forEach(g => {
                const match = g.getAttribute('data-date') === searchDate;
                g.style.display = match ? 'block' : 'none';
                if (match) found++;
            });
            resultDiv.innerHTML = found > 0
                ? `<span style="color:var(--success);">✓ 找到 ${found} 個日期的記錄</span>`
                : '<span style="color:var(--danger);">✗ 該日期沒有記錄</span>';
        }

        function clearSearch() {
            document.getElementById('searchDate').value = '';
            document.getElementById('searchResult').innerHTML = '';
            document.querySelectorAll('.date-group').forEach(g => g.style.display = 'block');
        }
    </script>
</body>
</html>
