@model HealthRecordViewModel
@{
    ViewData["Title"] = Model.Id > 0 ? "編輯健康紀錄" : "新增今日健康紀錄";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body>
    <style>
        :root {
            --navy: #0a2540;
            --navy-mid: #103a5e;
            --blue: #1a6fb5;
            --blue-lt: #2589d8;
            --bg: #f4f6f9;
            --surface: #ffffff;
            --border: #dde3ea;
            --text: #1a2635;
            --text-sub: #5a6a7e;
            --text-pale: #8fa0b4;
            --danger: #c0392b;
            --success: #2e7d32;
            --warning-bg: #fff8e1;
            --warning-border: #f59e0b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            min-height: 100%;
            font-family: 'Noto Sans TC', 'Microsoft JhengHei', sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        /* ── TOP BAR ── */
        .topbar {
            background: var(--navy);
            height: 56px;
            display: flex;
            align-items: center;
            padding: 0 2rem;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 12px rgba(0,0,0,0.25);
        }

        .topbar-logo {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: white;
            font-weight: 700;
            font-size: 1rem;
        }

        .cross {
            width: 28px;
            height: 28px;
            background: var(--blue-lt);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            font-weight: 900;
            color: white;
        }

        .topbar-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .topbar-back {
            color: rgba(255,255,255,0.65);
            background: none;
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 6px;
            padding: 0.3rem 0.85rem;
            font-size: 0.8rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.35rem;
            transition: all 0.2s;
        }

            .topbar-back:hover {
                background: rgba(255,255,255,0.1);
                color: white;
                text-decoration: none;
            }

        /* ── HERO ── */
        .hero {
            background: linear-gradient(100deg, var(--navy-mid) 0%, var(--blue) 100%);
            padding: 2rem 2.5rem 1.75rem;
            position: relative;
            overflow: hidden;
        }

            .hero::after {
                content: '';
                position: absolute;
                right: -60px;
                top: -60px;
                width: 240px;
                height: 240px;
                border-radius: 50%;
                background: rgba(255,255,255,0.04);
                pointer-events: none;
            }

        .hero-eyebrow {
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.5);
            margin-bottom: 0.4rem;
        }

        .hero-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: white;
            margin-bottom: 0.4rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .hero-sub {
            font-size: 0.82rem;
            color: rgba(255,255,255,0.55);
        }

        /* ── CONTENT ── */
        .form-container {
            max-width: 860px;
            margin: 0 auto;
            padding: 1.5rem 2.5rem;
        }

        /* ── ALERTS ── */
        .alert {
            padding: 0.75rem 1rem;
            border-radius: 8px;
            font-size: 0.83rem;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .alert-info {
            background: #e8f0fb;
            border: 1px solid #b8d0f5;
            color: #1a4a8a;
        }

        .alert-danger {
            background: #fdecea;
            border: 1px solid #f5c6c2;
            color: var(--danger);
        }

        /* ── FORM CARD ── */
        .form-section {
            background: var(--surface);
            border-radius: 12px;
            border: 1px solid var(--border);
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            overflow: hidden;
            margin-bottom: 1.25rem;
        }

        .section-title {
            padding: 0.85rem 1.25rem;
            border-bottom: 1px solid var(--border);
            background: var(--bg);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-sub);
        }

            .section-title i {
                color: var(--blue);
                font-size: 0.95rem;
            }

        .section-body {
            padding: 1.25rem;
        }

        /* ── FORM FIELDS ── */
        .form-row {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .field-label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-sub);
            margin-bottom: 0.4rem;
        }

            .field-label .required {
                color: var(--danger);
                margin-left: 0.2rem;
            }

        .form-control, .form-select {
            width: 100%;
            padding: 0.72rem 0.9rem;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-size: 0.9rem;
            font-family: inherit;
            color: var(--text);
            background: var(--surface);
            transition: border-color 0.2s, box-shadow 0.2s;
            outline: none;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--blue-lt);
                box-shadow: 0 0 0 3px rgba(37,137,216,0.12);
            }

            .form-control:disabled, .form-select:disabled {
                background-color: var(--bg);
                color: var(--text-pale);
                cursor: not-allowed;
                border-color: var(--border);
            }

        .field-hint {
            font-size: 0.75rem;
            color: var(--text-pale);
            margin-top: 0.3rem;
        }

        .field-error {
            font-size: 0.75rem;
            color: var(--danger);
            margin-top: 0.3rem;
        }

        /* ── BP BLOCKS ── */
        .bp-block {
            border-radius: 10px;
            padding: 1.25rem;
            margin-bottom: 1rem;
            border: 1px solid var(--border);
        }

        .bp-block-morning {
            background: #fffbeb;
            border-color: #fcd34d;
        }

        .bp-block-evening {
            background: #f5f3ff;
            border-color: #c4b5fd;
        }

        .bp-block-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .bp-block-title {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.95rem;
            font-weight: 700;
        }

        .bp-block-morning .bp-block-title {
            color: #92400e;
        }

        .bp-block-evening .bp-block-title {
            color: #4c1d95;
        }

        .bp-sub-block {
            background: rgba(255,255,255,0.75);
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 0.75rem;
            border: 1px solid rgba(0,0,0,0.08);
        }

        .bp-sub-title {
            font-size: 0.82rem;
            font-weight: 600;
            margin-bottom: 0.75rem;
        }

        .bp-block-morning .bp-sub-title {
            color: #b45309;
        }

        .bp-block-evening .bp-sub-title {
            color: #5b21b6;
        }

        .bp-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
        }

        .bp-hint {
            margin-top: 0.5rem;
            padding: 0.4rem 0.75rem;
            background: rgba(255,255,255,0.8);
            border-radius: 6px;
            font-size: 0.78rem;
        }

        .bp-block-morning .bp-hint {
            color: #b45309;
        }

        .bp-block-evening .bp-hint {
            color: #5b21b6;
        }

        .not-measured-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.35rem 0.8rem;
            border-radius: 6px;
            border: 1px solid #fcd34d;
            background: rgba(255,255,255,0.8);
            cursor: pointer;
        }

        .bp-block-evening .not-measured-label {
            border-color: #c4b5fd;
        }

        .locked-notice {
            background: #fff8e1;
            border: 1px solid var(--warning-border);
            border-radius: 8px;
            padding: 0.75rem 1rem;
            margin-bottom: 1rem;
            color: #92400e;
            font-size: 0.82rem;
            font-weight: 600;
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
        }

        /* ── MEAL SECTION ── */
        .meal-block {
            background: var(--bg);
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 0.75rem;
        }

        .meal-block-title {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--navy-mid);
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        /* ── BP INFO BOX ── */
        .info-box {
            background: #e8f0fb;
            border-left: 3px solid var(--blue);
            border-radius: 6px;
            padding: 0.85rem 1rem;
            font-size: 0.82rem;
            color: var(--navy-mid);
            margin-bottom: 1rem;
        }

            .info-box strong {
                color: var(--navy);
            }

        .standard-box {
            background: #f0f4ff;
            border-left: 3px solid var(--blue-lt);
            border-radius: 6px;
            padding: 0.85rem 1rem;
            font-size: 0.82rem;
            color: var(--navy-mid);
            margin-top: 0.75rem;
        }

        /* ── BUTTONS ── */
        .btn-row {
            display: flex;
            gap: 0.75rem;
            padding: 0.5rem 0 1.5rem 0;
            justify-content: flex-end;
        }

        .btn {
            padding: 0.65rem 1.75rem;
            border: none;
            border-radius: 8px;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            transition: background 0.15s;
            font-family: inherit;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--navy);
            color: white;
        }

            .btn-primary:hover {
                background: var(--navy-mid);
                color: white;
            }

        .btn-secondary {
            background: var(--surface);
            border: 1.5px solid var(--border);
            color: var(--text-sub);
        }

            .btn-secondary:hover {
                background: var(--bg);
                color: var(--text-sub);
                text-decoration: none;
            }

        @@media (max-width: 768px) {
            .topbar {
                padding: 0 1rem;
            }

            .hero {
                padding: 1.5rem 1.25rem;
            }

            .form-container {
                padding: 1rem;
            }

            .form-row, .bp-grid {
                grid-template-columns: 1fr;
            }

            .btn-row {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>

    <!-- TOP BAR -->
    <header class="topbar">
        <div class="topbar-logo">
            <div class="cross">✚</div>
            代謝症候群疾病管理與追蹤系統
        </div>
        <div class="topbar-right">
            <a href="@Url.Action("Index", "DailyHealth")" class="topbar-back">
                <i class="bi bi-arrow-left"></i> 返回選單
            </a>
        </div>
    </header>

    <!-- HERO -->
    <div class="hero">
        <div class="hero-eyebrow">Daily Health Record</div>
        <div class="hero-title">
            <i class="bi bi-pencil-square"></i>
            @ViewData["Title"]
        </div>
        <div class="hero-sub">@DateTime.Today.ToString("yyyy年MM月dd日")</div>
    </div>

    <!-- CONTENT -->
    <div class="form-container">

        <form asp-action="@(Model.Id > 0 ? "Edit" : "Create")" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />

            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle-fill"></i> @TempData["InfoMessage"]
                </div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <div asp-validation-summary="All"></div>
                </div>
            }
            @if (TempData["BPWarnings"] != null)
            {
                var bpMessages = TempData["BPWarnings"].ToString().Split('\n');
                var hasErrors = bpMessages.Any(m => m.StartsWith("🔴"));
                <div class="alert @(hasErrors ? "alert-danger" : "alert-info")">
                    <i class="bi bi-@(hasErrors ? "exclamation" : "info")-circle-fill"></i>
                    <div>@foreach (var msg in bpMessages)
                        {
                            <p style="margin:0;">@msg</p>
                        }</div>
                </div>
            }

            <!-- 血壓 -->
            <div class="form-section">
                <div class="section-title">
                    <i class="bi bi-heart-pulse-fill"></i>
                    血壓測量 (mmHg)
                </div>
                <div class="section-body">

                    @if (Model.IsMorningCompletedToday || Model.IsEveningCompletedToday)
                    {
                        <div class="locked-notice">
                            <i class="bi bi-lock-fill"></i>
                            <div>
                                @if (Model.IsMorningCompletedToday && Model.IsEveningCompletedToday)
                                {
                                    <div>今日上午血壓與睡前血壓已完成記錄，無法再次勾選「尚未測量」。</div>
                                }
                                else if (Model.IsMorningCompletedToday)
                                {
                                    <div>今日上午血壓已完成記錄，無法再次勾選「尚未測量」。</div>
                                }
                                else if (Model.IsEveningCompletedToday)
                                {
                                    <div>今日睡前血壓已完成記錄，無法再次勾選「尚未測量」。</div>
                                }
                                <div style="margin-top:0.25rem; font-weight:400;">若要修改，請前往「我的紀錄」頁面編輯。</div>
                            </div>
                        </div>
                    }

                    <div class="info-box">
                        <strong>📍 測量時間說明</strong><br>
                        • <strong>上午</strong>：起床後 1 小時內，早餐前&nbsp;&nbsp;
                        • <strong>睡前</strong>：睡覺前 1 小時內<br>
                        • 每次測量間隔 1-2 分鐘，取兩遍的平均值
                    </div>

                    <input type="hidden" id="BP_Morning_NotMeasured" name="BP_Morning_NotMeasured" value="false" />
                    <input type="hidden" id="BP_Evening_NotMeasured" name="BP_Evening_NotMeasured" value="false" />

                    <!-- 上午 -->
                    <div class="bp-block bp-block-morning">
                        <div class="bp-block-header">
                            <div class="bp-block-title">
                                <i class="bi bi-sunrise-fill"></i> 第一次（上午）
                            </div>
                            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.25rem;">
                                <label class="not-measured-label"
                                       style="@(Model.IsMorningCompletedToday ? "opacity:0.5; cursor:not-allowed;" : "")">
                                    <input type="checkbox" id="morning_not_measured"
                                           onchange="toggleMorningBP(this.checked)"
                                           style="width:16px; height:16px;"
                                    @(Model.IsMorningCompletedToday ? "disabled" : "")>
                                    尚未測量
                                </label>
                                @if (Model.IsMorningCompletedToday)
                                {
                                    <div style="font-size:0.73rem; color:#92400e;">
                                        已完成今日上午血壓，若要修改請至「我的紀錄」
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="bp-sub-block">
                            <div class="bp-sub-title">📍 第一遍</div>
                            <div class="bp-grid">
                                <div>
                                    <label class="field-label">收縮壓（上壓）</label>
                                    <input asp-for="BP_First_1_Systolic" type="number" class="form-control morning-bp-input" placeholder="例：120" min="30" max="250" step="1" />
                                    <span asp-validation-for="BP_First_1_Systolic" class="field-error"></span>
                                </div>
                                <div>
                                    <label class="field-label">舒張壓（下壓）</label>
                                    <input asp-for="BP_First_1_Diastolic" type="number" class="form-control morning-bp-input" placeholder="例：80" min="10" max="150" step="1" />
                                    <span asp-validation-for="BP_First_1_Diastolic" class="field-error"></span>
                                </div>
                            </div>
                        </div>

                        <div class="bp-sub-block">
                            <div class="bp-sub-title">📍 第二遍</div>
                            <div class="bp-grid">
                                <div>
                                    <label class="field-label">收縮壓（上壓）</label>
                                    <input asp-for="BP_First_2_Systolic" type="number" class="form-control morning-bp-input" placeholder="例：118" min="30" max="250" step="1" />
                                    <span asp-validation-for="BP_First_2_Systolic" class="field-error"></span>
                                </div>
                                <div>
                                    <label class="field-label">舒張壓（下壓）</label>
                                    <input asp-for="BP_First_2_Diastolic" type="number" class="form-control morning-bp-input" placeholder="例：78" min="10" max="150" step="1" />
                                    <span asp-validation-for="BP_First_2_Diastolic" class="field-error"></span>
                                </div>
                            </div>
                        </div>
                        <div class="bp-hint">💡 若填第一遍，請記得填第二遍</div>
                    </div>

                    <!-- 睡前 -->
                    <div class="bp-block bp-block-evening">
                        <div class="bp-block-header">
                            <div class="bp-block-title">
                                <i class="bi bi-moon-stars-fill"></i> 第二次（睡前）
                            </div>
                            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.25rem;">
                                <label class="not-measured-label"
                                       style="@(Model.IsEveningCompletedToday ? "opacity:0.5; cursor:not-allowed;" : "") border-color:#c4b5fd;">
                                    <input type="checkbox" id="evening_not_measured"
                                           onchange="toggleEveningBP(this.checked)"
                                           style="width:16px; height:16px;"
                                    @(Model.IsEveningCompletedToday ? "disabled" : "")>
                                    尚未測量
                                </label>
                                @if (Model.IsEveningCompletedToday)
                                {
                                    <div style="font-size:0.73rem; color:#4c1d95;">
                                        已完成今日睡前血壓，若要修改請至「我的紀錄」
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="bp-sub-block">
                            <div class="bp-sub-title">📍 第一遍</div>
                            <div class="bp-grid">
                                <div>
                                    <label class="field-label">收縮壓（上壓）</label>
                                    <input asp-for="BP_Second_1_Systolic" type="number" class="form-control evening-bp-input" placeholder="例：115" min="30" max="250" step="1" />
                                    <span asp-validation-for="BP_Second_1_Systolic" class="field-error"></span>
                                </div>
                                <div>
                                    <label class="field-label">舒張壓（下壓）</label>
                                    <input asp-for="BP_Second_1_Diastolic" type="number" class="form-control evening-bp-input" placeholder="例：75" min="10" max="150" step="1" />
                                    <span asp-validation-for="BP_Second_1_Diastolic" class="field-error"></span>
                                </div>
                            </div>
                        </div>

                        <div class="bp-sub-block">
                            <div class="bp-sub-title">📍 第二遍</div>
                            <div class="bp-grid">
                                <div>
                                    <label class="field-label">收縮壓（上壓）</label>
                                    <input asp-for="BP_Second_2_Systolic" type="number" class="form-control evening-bp-input" placeholder="例：117" min="30" max="250" step="1" />
                                    <span asp-validation-for="BP_Second_2_Systolic" class="field-error"></span>
                                </div>
                                <div>
                                    <label class="field-label">舒張壓（下壓）</label>
                                    <input asp-for="BP_Second_2_Diastolic" type="number" class="form-control evening-bp-input" placeholder="例：77" min="10" max="150" step="1" />
                                    <span asp-validation-for="BP_Second_2_Diastolic" class="field-error"></span>
                                </div>
                            </div>
                        </div>
                        <div class="bp-hint">💡 若填第一遍，請記得填第二遍</div>
                    </div>

                    <div class="standard-box">
                        <strong>📋 血壓標準值</strong>
                        <ul style="margin: 0.4rem 0 0 1.2rem; line-height: 1.8;">
                            <li>正常血壓：收縮壓 &lt; 120 mmHg、舒張壓 &lt; 80 mmHg</li>
                            <li>高血壓前期：收縮壓 120–139 mmHg 或舒張壓 80–89 mmHg</li>
                            <li>高血壓：收縮壓 ≥ 140 mmHg 或舒張壓 ≥ 90 mmHg</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 三餐 -->
            <div class="form-section">
                <div class="section-title">
                    <i class="bi bi-egg-fried"></i>
                    三餐攝取
                    <span style="font-size:0.75rem; font-weight:400; color:var(--text-pale); margin-left:0.5rem;">0~10，最多小數點後一位</span>
                </div>
                <div class="section-body">
                    @foreach (var meal in new[] { ("breakfast", "🌅 早餐"), ("lunch", "☀️ 午餐"), ("dinner", "🌙 晚餐") })
                    {
                        <div class="meal-block">
                            <div class="meal-block-title">@meal.Item2</div>
                            <div class="form-row" style="grid-template-columns: repeat(3,1fr);">
                                @foreach (var item in new[] { ("veg", "蔬菜"), ("protein", "蛋白質"), ("carbs", "澱粉") })
                                {
                                    <div>
                                        <label class="field-label">@item.Item2（拳頭）</label>
                                        <input type="text" class="form-control meal-input"
                                               id="@meal.Item1-@item.Item1"
                                               placeholder="例：1.5" inputmode="decimal"
                                               oninput="validateMealInput(this)" />
                                        <div class="field-error" id="@meal.Item1-@item.Item1-err" style="display:none;"></div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    <input type="hidden" id="Meals_Breakfast_Json" name="Meals_Breakfast" />
                    <input type="hidden" id="Meals_Lunch_Json" name="Meals_Lunch" />
                    <input type="hidden" id="Meals_Dinner_Json" name="Meals_Dinner" />
                </div>
            </div>

            <!-- 運動 -->
            <div class="form-section">
                <div class="section-title"><i class="bi bi-bicycle"></i> 運動資訊</div>
                <div class="section-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="field-label" asp-for="ExerciseType">運動種類</label>
                            <input asp-for="ExerciseType" class="form-control" placeholder="例如：慢跑、游泳、騎腳踏車" />
                        </div>
                        <div class="form-group">
                            <label class="field-label" asp-for="ExerciseDuration">運動時間（分鐘）</label>
                            <input asp-for="ExerciseDuration" type="number" step="0.1" class="form-control" placeholder="0" />
                            <div class="field-hint">建議每日運動至少 30 分鐘</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 飲品 -->
            <div class="form-section">
                <div class="section-title"><i class="bi bi-droplet-fill"></i> 飲品攝取</div>
                <div class="section-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="field-label" asp-for="WaterIntake">水分攝取（ml）</label>
                            <input asp-for="WaterIntake" type="number" class="form-control" placeholder="0" />
                            <div class="field-hint">建議每日飲水 2000 ml</div>
                        </div>
                        <div class="form-group">
                            <label class="field-label" asp-for="Beverage">其他飲料</label>
                            <input asp-for="Beverage" class="form-control" placeholder="例如：咖啡、茶、果汁" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 生活習慣 -->
            <div class="form-section">
                <div class="section-title"><i class="bi bi-lungs-fill"></i> 生活習慣</div>
                <div class="section-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="field-label" asp-for="Cigarettes">抽菸支數</label>
                            <input asp-for="Cigarettes" type="number" class="form-control" placeholder="0" />
                            <div class="field-hint">建議戒菸以維護健康</div>
                        </div>
                        <div class="form-group">
                            <label class="field-label" asp-for="BetelNut">嚼檳榔次數</label>
                            <input asp-for="BetelNut" type="number" class="form-control" placeholder="0" />
                            <div class="field-hint">建議戒除檳榔以維護健康</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 血糖 -->
            <div class="form-section">
                <div class="section-title"><i class="bi bi-droplet-half"></i> 血糖</div>
                <div class="section-body">
                    <div class="form-group" style="max-width:320px;">
                        <label class="field-label" asp-for="BloodSugar">血糖（mg/dL）</label>
                        <input asp-for="BloodSugar" type="number" step="0.1" class="form-control" placeholder="0" />
                        <div class="field-hint">正常值：70–99 mg/dL</div>
                    </div>
                </div>
            </div>

            <div class="btn-row">
                <a href="@Url.Action("Index", "DailyHealth")" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> 取消
                </a>
                <button type="submit" class="btn btn-primary" onclick="return validateAllMeals() && prepareMealData()">
                    <i class="bi bi-@(Model.Id > 0 ? "floppy" : "check-lg")"></i>
                    @(Model.Id > 0 ? "儲存修改" : "下一步")
                </button>
            </div>
        </form>
    </div>

    <script>
        const isMorningCompleted = @Json.Serialize(Model.IsMorningCompletedToday);
        const isEveningCompleted = @Json.Serialize(Model.IsEveningCompletedToday);

        function toggleMorningBP(checked) {
            document.querySelectorAll('.morning-bp-input').forEach(input => {
                if (isMorningCompleted) { input.disabled = true; input.style.backgroundColor = 'var(--bg)'; }
                else {
                    input.disabled = checked;
                    input.style.backgroundColor = checked ? 'var(--bg)' : 'var(--surface)';
                    if (checked) input.value = '';
                }
            });
            document.getElementById('BP_Morning_NotMeasured').value = checked ? 'true' : 'false';
        }

        function toggleEveningBP(checked) {
            document.querySelectorAll('.evening-bp-input').forEach(input => {
                if (isEveningCompleted) { input.disabled = true; input.style.backgroundColor = 'var(--bg)'; }
                else {
                    input.disabled = checked;
                    input.style.backgroundColor = checked ? 'var(--bg)' : 'var(--surface)';
                    if (checked) input.value = '';
                }
            });
            document.getElementById('BP_Evening_NotMeasured').value = checked ? 'true' : 'false';
        }

        function validateMealInput(input) {
            const errEl = document.getElementById(input.id + '-err');
            let val = input.value.replace(/[^0-9.]/g, '');
            const parts = val.split('.');
            if (parts.length > 2) val = parts[0] + '.' + parts[1];
            if (parts.length === 2 && parts[1].length > 1) val = parts[0] + '.' + parts[1].substring(0, 1);
            input.value = val;
            if (val === '' || val === '.') { if (errEl) { errEl.style.display = 'none'; errEl.textContent = ''; } return; }
            const num = parseFloat(val);
            if (isNaN(num) || num < 0 || num > 10) {
                if (errEl) { errEl.style.display = 'block'; errEl.textContent = '請輸入 0 到 10 之間的數字'; }
            } else {
                if (errEl) { errEl.style.display = 'none'; errEl.textContent = ''; }
            }
        }

        function validateAllMeals() {
            for (const input of document.querySelectorAll('.meal-input')) {
                if (input.value === '' || input.value === '.') continue;
                const num = parseFloat(input.value);
                if (isNaN(num) || num < 0 || num > 10) {
                    alert('三餐數值請填入 0 到 10 之間，且最多小數點後一位');
                    input.focus(); return false;
                }
            }
            return true;
        }

        function prepareMealData() {
            const serialize = (vegId, proId, carbId, hidId) => {
                const v = document.getElementById(vegId)?.value;
                const p = document.getElementById(proId)?.value;
                const c = document.getElementById(carbId)?.value;
                document.getElementById(hidId).value = (v || p || c)
                    ? JSON.stringify({ Vegetables: v, Protein: p, Carbs: c }) : '';
            };
            serialize('breakfast-veg', 'breakfast-protein', 'breakfast-carbs', 'Meals_Breakfast_Json');
            serialize('lunch-veg', 'lunch-protein', 'lunch-carbs', 'Meals_Lunch_Json');
            serialize('dinner-veg', 'dinner-protein', 'dinner-carbs', 'Meals_Dinner_Json');
            return true;
        }

        document.addEventListener('DOMContentLoaded', function () {
            // 血壓只能整數
            document.querySelectorAll('.morning-bp-input, .evening-bp-input').forEach(input => {
                input.addEventListener('input', () => { input.value = input.value.replace(/[^0-9]/g, ''); });
                input.addEventListener('paste', e => {
                    e.preventDefault();
                    const t = e.clipboardData.getData('text');
                    if (/^\d+$/.test(t)) input.value = t;
                });
            });

            // 初始化血壓狀態
            const mc = document.getElementById('morning_not_measured');
            if (mc) {
        @if (Model.BP_Morning_NotMeasured.HasValue && Model.BP_Morning_NotMeasured.Value)
        {
            <text>mc.checked = true;</text>
        }
                    if (isMorningCompleted) {
                    document.querySelectorAll('.morning-bp-input').forEach(i => { i.disabled = true; i.style.backgroundColor = 'var(--bg)'; });
                } else { toggleMorningBP(mc.checked); }
            }
            const ec = document.getElementById('evening_not_measured');
            if (ec) {
        @if (Model.BP_Evening_NotMeasured.HasValue && Model.BP_Evening_NotMeasured.Value)
        {
            <text>ec.checked = true;</text>
        }
                    if (isEveningCompleted) {
                    document.querySelectorAll('.evening-bp-input').forEach(i => { i.disabled = true; i.style.backgroundColor = 'var(--bg)'; });
                } else { toggleEveningBP(ec.checked); }
            }

            // 恢復三餐資料
        @if (Model.Meals_Breakfast != null)
        {
            <text>
                        const bf = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Meals_Breakfast));
                        if (bf.Vegetables) document.getElementById('breakfast-veg').value = bf.Vegetables;
                        if (bf.Protein) document.getElementById('breakfast-protein').value = bf.Protein;
                        if (bf.Carbs) document.getElementById('breakfast-carbs').value = bf.Carbs;
            </text>
        }
        @if (Model.Meals_Lunch != null)
        {
            <text>
                        const lc = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Meals_Lunch));
                        if (lc.Vegetables) document.getElementById('lunch-veg').value = lc.Vegetables;
                        if (lc.Protein) document.getElementById('lunch-protein').value = lc.Protein;
                        if (lc.Carbs) document.getElementById('lunch-carbs').value = lc.Carbs;
            </text>
        }
        @if (Model.Meals_Dinner != null)
        {
            <text>
                        const dn = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Meals_Dinner));
                        if (dn.Vegetables) document.getElementById('dinner-veg').value = dn.Vegetables;
                        if (dn.Protein) document.getElementById('dinner-protein').value = dn.Protein;
                        if (dn.Carbs) document.getElementById('dinner-carbs').value = dn.Carbs;
            </text>
        }

                // 其他欄位輸入限制（整數）
                ['WaterIntake', 'Cigarettes', 'BetelNut'].forEach(name => {
                    const el = document.querySelector(`input[name="${name}"]`);
                    if (!el) return;
                    el.addEventListener('input', () => { el.value = el.value.replace(/[^0-9]/g, ''); });
                });
        });
    </script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
